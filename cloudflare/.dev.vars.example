# Copy to .dev.vars for local testing (npx wrangler dev). NEVER commit .dev.vars.
# Same values as your root .env file.
SFTP_PASS=your-sftp-password
# Any random 32+ char string; signs session cookies (in production: wrangler secret put AUTH_SECRET)
AUTH_SECRET=change-me-to-a-long-random-string
#
# Server Monitoring needs NO extra key or secret. It reads the server's live facts over the SAME
# SSH/SFTP connection the dashboard already uses, so it relies only on the SFTP credentials above
# (SFTP_HOST / SFTP_USER / SFTP_PASS, plus AUTH_SECRET for sessions) that are already configured on
# the Worker. Nothing new to add here.
